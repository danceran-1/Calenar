<FrameLayout
    android:id="@+id/root_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/page_iphone_16_pro___3_ek1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <View
                android:id="@+id/_bg__iphone_16_pro___3_ek2"
                android:layout_width="410dp"
                android:layout_height="874dp"
                android:background="@drawable/_bg__iphone_16_pro___3_ek2_shape" />

            <ScrollView
                android:id="@+id/iphone_16_pro___3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <HorizontalScrollView
                    android:id="@+id/horizontalScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/daysContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </ScrollView>

            <View
                android:id="@+id/rectangle_51"
                android:layout_width="wrap_content"
                android:layout_height="154dp"
                android:layout_marginStart="-4dp"
                android:background="@drawable/rectangle_51_shape" />

            <RelativeLayout
                android:id="@+id/arrow_alt_right_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginStart="364dp">
            </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="70dp">


                <ImageView
                    android:id="@+id/rec"
                    android:layout_width="58dp"
                    android:layout_height="43dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="45dp"
                    android:layout_marginBottom="94dp"

                    android:contentDescription="polygon_2"
                    android:src="@drawable/rectangle_79" />

                <ImageView
                    android:id="@+id/menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_alignEnd="@+id/rec"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="13dp"

                    android:layout_marginBottom="-22dp"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/menu_burger_2" />

                <ImageButton
                    android:id="@+id/buttonPreviousWeek"
                    android:layout_width="60dp"
                    android:layout_height="30dp"

                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="47dp"
                    android:layout_marginTop="48dp"
                    android:layout_marginBottom="47dp"
                    android:background="@drawable/button_background"
                    android:contentDescription="vector_ek1"
                    android:src="@drawable/vector_ek1" />

                <ImageView
                    android:id="@+id/pn"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="43dp"
                    android:layout_marginTop="79dp"


                    android:contentDescription="polygon_2"
                    android:src="@drawable/__" />

                <ImageView
                    android:id="@+id/vt"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/pn"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/vt" />

                <ImageView
                    android:id="@+id/cp"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/vt"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/__" />

                <ImageView
                    android:id="@+id/ch"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/cp"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/ch" />

                <ImageView
                    android:id="@+id/pt"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/ch"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/pt" />

                <ImageView
                    android:id="@+id/cb"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/pt"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/cb" />

                <ImageView
                    android:id="@+id/vc"
                    android:layout_width="36dp"
                    android:layout_height="19dp"

                    android:layout_alignParentTop="true"
                    android:layout_marginStart="13dp"


                    android:layout_marginTop="79dp"
                    android:layout_toEndOf="@+id/cb"
                    android:contentDescription="polygon_2"
                    android:src="@drawable/vc" />


            </RelativeLayout>

            <LinearLayout
                android:id="@+id/weekNavigationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/rectangle_51"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="0dp"
                android:gravity="center"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:id="@+id/weekDaysScrollView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/weekDaysContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

            </LinearLayout>




            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/schedule_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:layout_below="@+id/rectangle_51"
                android:layout_marginTop="5dp"
                app:layout_constraintBottom_toBottomOf="parent" />

            <View
                android:id="@+id/current_time_indicator"
                android:layout_width="328dp"
                android:layout_height="0dp"
                android:background="@color/blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/schedule_list" />

            <ImageButton
                android:id="@+id/buttonNextWeek"
                android:layout_width="60dp"
                android:layout_height="30dp"

                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="48dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="70dp"
                android:background="@drawable/button_background"
                android:contentDescription="vector"
                android:src="@drawable/vector" />

            <ImageView
                android:id="@+id/line"
                android:layout_width="4dp"
                android:layout_height="1000dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="38.5dp"
                android:layout_marginTop="148dp"
                android:src="@drawable/line_2" />

            <ImageView
                android:id="@+id/line2"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="86dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />
            <ImageView
                android:id="@+id/line3"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="134dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />
            <ImageView
                android:id="@+id/line4"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="182dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />

            <ImageView
                android:id="@+id/line5"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="229.5dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />
            <ImageView
                android:id="@+id/line6"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="278dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />
            <ImageView
                android:id="@+id/line7"
                android:layout_width="4dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="326dp"
                android:layout_marginTop="148dp"

                android:src="@drawable/line_2" />



            <ImageView
                android:id="@+id/forma_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="542dp"
                android:layout_marginEnd="22dp"
                android:layout_marginBottom="50dp"

                android:contentDescription="vector"
                android:src="@drawable/forma_add" />

            <ImageView
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="553dp"
                android:layout_marginEnd="33dp"
                android:layout_marginBottom="55dp"
                android:contentDescription="vector"
                android:src="@drawable/add_1" />


        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
