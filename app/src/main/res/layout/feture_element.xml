<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:clipToPadding="true"
    android:padding="0dp"
    android:layout_gravity="center"
    android:background="@drawable/rounded_rectangle">

    <ImageView
        android:id="@+id/icon_event_type"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_event_pill"
        android:layout_marginStart="4dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp" />
    <!-- Текст даты и времени -->
    <TextView
        android:id="@+id/text_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пятница 15.11.2024 - 14:00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/fots_regular"
        android:textColor="#295B75"
        android:layout_marginStart="35dp"
        android:layout_marginTop="8dp"
        android:layout_alignParentTop="true" />

    <!-- Текст описания события -->
    <TextView
        android:id="@+id/text_event_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_date_time"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="110dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/fots_regular"
        android:text="Мнго интереаваыаысного я гей кста."
        android:textColor="#295B75"
        android:textSize="16sp"
        android:ellipsize="none"
        android:scrollHorizontally="false" />

    <!-- Кнопка отметки выполненного -->
    <Button
        android:id="@+id/button_mark_done"
        android:layout_width="95dp"
        android:layout_height="48dp"
        android:text="Информация\nо событии"
        android:backgroundTint="#1ECFDB"
        android:textColor="#FFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:fontFamily="@font/fots_regular"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="5dp"
        android:padding="2dp"
        android:background="@drawable/button_rounded"/>
</RelativeLayout>
