<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/blue_rounded_rectangle_with_border"
    android:layout_marginTop="2dp"
    android:padding="8dp">

    <!-- Иконка события -->
    <ImageView
        android:id="@+id/icon_event_type"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_event_syringe"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp" />

    <!-- Время события -->
    <TextView
        android:id="@+id/text_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11:00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/fots_regular"
        android:textColor="#295B75"
        android:layout_toEndOf="@id/icon_event_type"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp" />

    <!-- Описание события -->
    <TextView
        android:id="@+id/text_event_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Принять таблетку ципралета"
        android:textSize="16sp"
        android:fontFamily="@font/fots_regular"
        android:textColor="#295B75"
        android:layout_toEndOf="@id/icon_event_type"
        android:layout_below="@id/text_time"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="60dp" />

    <!-- Маленький прямоугольник с галочкой -->
    <RelativeLayout
        android:id="@+id/rectangle_with_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:background="@drawable/small_rectangle_background">

        <ImageView
            android:id="@+id/check_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_checkmark" />
    </RelativeLayout>

</RelativeLayout>
